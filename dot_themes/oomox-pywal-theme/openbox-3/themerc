# Menu
menu.border.color: #babdc9

menu.title.bg: Solid Flat
menu.title.bg.color: #222a36
menu.title.bg.shadow: 0
menu.title.text.color: #babdc9
menu.title.text.justify: Center

menu.items.bg: Solid Flat
menu.items.bg.color: #222a36
menu.items.text.color: #babdc9
menu.items.disabled.text.color: #9498a4

menu.items.active.bg: Solid Flat
menu.items.active.bg.color: #3071e1
menu.items.active.text.color: #babdc9

menu.separator.color: #9498a4
menu.separator.width: 1
menu.separator.padding.width: 2
menu.separator.padding.height: 4

# Window focused
window.active.title.separator.color: #222a36

# Active window
window.active.border.color: #3071e1


window.active.title.bg: flat solid
window.active.title.bg.color: #222a36
window.active.title.separator.color: #222a36
window.active.text.justify: center

window.active.label.bg: parentrelative
window.active.label.text.color: #babdc9

window.active.handle.bg: flat solid
window.active.handle.bg.color: #222a36

window.active.grip.bg: flat solid
window.active.grip.bg.color: #222a36

window.active.button.unpressed.bg: flat solid
window.active.button.unpressed.bg.color: #222a36
window.active.button.unpressed.image.color: #babdc9

window.active.button.pressed.bg: flat solid
window.active.button.pressed.bg.color: #3071e1
window.active.button.pressed.image.color: #222a36

window.active.button.disabled.bg: flat solid
window.active.button.disabled.bg.color: #222a36
window.active.button.disabled.image.color: #9498a4

window.active.button.hover.bg: flat solid
window.active.button.hover.bg.color: #222a36
window.active.button.hover.image.color: #3071e1

#window.active.button.toggled.bg: #3071e1
#window.active.button.toggled.image.color: #222a36

# Inactive window
window.inactive.border.color: #222a36

window.inactive.title.bg: flat solid
window.inactive.title.bg.color: #222a36
window.inactive.title.separator.color: #222a36
window.inactive.text.justify: center

window.inactive.label.bg: parentrelative
window.inactive.label.text.color: #9498a4

window.inactive.handle.bg: flat solid
window.inactive.handle.bg.color: #222a36

window.inactive.grip.bg: flat solid
window.inactive.grip.bg.color: #222a36

window.inactive.button.unpressed.bg: flat solid
window.inactive.button.unpressed.bg.color: #222a36
window.inactive.button.unpressed.image.color: #9498a4

window.inactive.button.pressed.bg: flat solid
window.inactive.button.pressed.bg.color: #3071e1
window.inactive.button.pressed.image.color: #222a36

window.inactive.button.disabled.bg: flat solid
window.inactive.button.disabled.bg.color: #9498a4
window.inactive.button.disabled.image.color: #222a36

window.inactive.button.hover.bg: flat solid
window.inactive.button.hover.bg.color: #222a36
window.inactive.button.hover.image.color: #3071e1


# OSD
osd.border.width: 1
osd.border.color: #3071e1

osd.bg: flat solid
osd.bg.color: #222a36
osd.label.bg: flat solid
osd.label.bg.color: #222a36
osd.label.text.color: #babdc9

# OSD
osd.bg: Solid Flat
osd.bg.color: #222a36
osd.bg.shadow: 0

osd.border.width: 2
osd.hilight.bg: Solid Flat
osd.hilight.bg.color: #3071e1
osd.unhilight.bg: flat solid
osd.unhilight.bg.color: #222a36

osd.button.unpressed.bg: flat border
osd.button.unpressed.bg.color: #222a36
#osd.button.unpressed.*.border.color: #babdc9

osd.button.pressed.bg: flat border
osd.button.pressed.bg.color: #3071e1
#osd.button.pressed.*.border.color: #222a36

osd.button.focused.bg: flat solid border
osd.button.focused.bg.color: #babdc9
#osd.button.focused.*.border.color: #222a36

osd.button.focused.box.color: #3071e1


# Fonts
window.active.label.text.font:shadow=n
window.inactive.label.text.font:shadow=n
menu.items.font:shadow=n
menu.title.text.font:shadow=n


# Everything else
border.width: 3
padding.width: 8
padding.height: 3
window.handle.width: 0
window.client.padding.width: 0
window.label.text.justify: center
#menu.overlap: 0
